{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@mimelux/core/legal": ["../../packages/core/dist/legal.d.ts"],
      "@mimelux/core/monetization": ["../../packages/core/dist/monetization.d.ts"],
      "@mimelux/core/chat-sequence": ["../../packages/core/dist/chat-sequence.d.ts"],
      "@mimelux/core/exclusive-video": ["../../packages/core/dist/exclusive-video.d.ts"],
      "@mimelux/core/expay": ["../../packages/core/dist/expay.d.ts"],
      "@mimelux/core/stripe": ["../../packages/core/dist/stripe.d.ts"],
      "@mimelux/core/return-path": ["../../packages/core/dist/return-path.d.ts"],
      "@mimelux/db/runtime": ["../../packages/db/dist/index.d.ts"]
    },
    "incremental": true,
    "isolatedModules": false,
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
