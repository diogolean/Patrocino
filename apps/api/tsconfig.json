{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@mimelux/core/legal": ["../../packages/core/dist/legal.d.ts"],
      "@mimelux/core/monetization": ["../../packages/core/dist/monetization.d.ts"],
      "@mimelux/core/expay": ["../../packages/core/dist/expay.d.ts"],
      "@mimelux/db/runtime": ["../../packages/db/dist/index.d.ts"]
    },
    "incremental": true,
    "isolatedModules": false,
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
