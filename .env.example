# Modo de conteúdo: general | adult | hybrid
CONTENT_MODE=hybrid
NEXT_PUBLIC_CONTENT_MODE=hybrid

# PostgreSQL local (Docker Compose)
DATABASE_URL=postgresql://mimelux:mimelux_dev@localhost:5432/mimelux?schema=public

# Troque por valores longos e aleatórios fora do demo
AUTH_SECRET=change-me
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Server-side base used by the Next session routes. Includes the /v1 prefix.
API_URL=http://127.0.0.1:3334/v1
WEB_ORIGIN=http://127.0.0.1:3333
# httpOnly cookies are Secure in production. Set true only behind HTTPS.
COOKIE_SECURE=false
# Auth limit per real client IP. Production defaults to 10 when unset and NODE_ENV=production.
AUTH_RATE_LIMIT=120
# Failed login attempts per email inside AUTH_RATE_TTL_MS. Defaults to 5.
AUTH_EMAIL_FAIL_LIMIT=5
AUTH_RATE_TTL_MS=60000
# Shared by the Next server and the API. The API trusts x-patrocino-client-ip only with this secret.
INTERNAL_PROXY_SECRET=
# Express trust proxy (true, a hop count, or loopback). Leave false to ignore raw X-Forwarded-For.
TRUST_PROXY=false

# Verification email. When RESEND_API_KEY is empty, the API logs the link and login stays open.
RESEND_API_KEY=
EMAIL_FROM=Patrocino <no-reply@patrocino.com>

# O web continua em mocks se a API estiver offline
NEXT_PUBLIC_API_URL=http://localhost:3334/v1
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Created on seed and API startup only when both are set. Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe stays off until real keys are present. Live keys also require STRIPE_ALLOW_LIVE=true.
# sk_test_ and pk_test_ work while STRIPE_ALLOW_LIVE is false. rk_test_ is rejected.
# Live charges accept sk_live_ or a restricted rk_live_ only when STRIPE_ALLOW_LIVE=true.
# Put live keys in the host environment, not in this file.
# Webhook URL: POST https://patrocino.com/v1/payments/webhooks/stripe
# Header: Stripe-Signature. Checkout return URLs use WEB_ORIGIN.
# Subscribe to: checkout.session.completed, invoice.paid, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted, charge.refunded,
# payment_intent.succeeded, payment_intent.payment_failed.
# payment_intent.succeeded grants access when metadata.purchaseId is an existing Purchase.
# An unknown purchase id is stored and does not change access. Other signed events are stored.
# The side-by-side card button creates a PaymentIntent. Restricted-key minimum for that call:
# PaymentIntents Write (payment_intent_write) on POST /v1/payment_intents with
# automatic_payment_methods. Webhook verification is local and does not need endpoint permissions.
# Subscription checkout still creates Customers, Products, Prices, and Checkout Sessions, and
# updates Subscriptions. A restricted key used for that flow needs those permissions too.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Checkout methods on the demo checkout page. Both false keeps "Simular pagamento".
# Set either flag to true in the host environment to show that method.
# PAYMENTS_PROVIDER is not the switch. These flags gate Pix and the card button, not webhooks.
PAYMENTS_EXPAY_ENABLED=false
PAYMENTS_STRIPE_ENABLED=false
PAYMENTS_PROVIDER=demo

# ExPay Brasil. Never commit a real key. Test and production both POST to
# https://patrocino.com/v1/payments/expay/webhook and each has its own signing secret.
# A webhook is accepted when it matches either secret. Only the prod secret grants
# access, unless EXPAY_ACCEPT_TEST_EVENTS=true. When the flag is unset it is true
# only if NODE_ENV is set and is not production. Keep the flag false in production.
EXPAY_API_KEY=
EXPAY_BASE_URL=https://api.expaybrasil.com/api/v1
EXPAY_WEBHOOK_SECRET_TEST=
EXPAY_WEBHOOK_SECRET_PROD=
EXPAY_ACCEPT_TEST_EVENTS=false
# TODO-to-confirm: the signing header name is a guess. Replace it when ExPay confirms the header.
EXPAY_WEBHOOK_SIGNATURE_HEADER=X-Expay-Signature

# weekly | biweekly | monthly. The weekly default is not a confirmed product decision.
NEXT_PUBLIC_PAYOUT_SCHEDULE=weekly

# Creator uploads. On the VPS this directory is bind-mounted into the API container.
MEDIA_ROOT=/opt/patrocino/media
MEDIA_PHOTO_MAX_BYTES=31457280
MEDIA_VIDEO_MAX_BYTES=2000000000
MEDIA_CHUNK_BYTES=5242880
