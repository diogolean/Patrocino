# Modo de conteúdo: general | adult | hybrid
CONTENT_MODE=hybrid
NEXT_PUBLIC_CONTENT_MODE=hybrid

# PostgreSQL local (Docker Compose)
DATABASE_URL=postgresql://mimelux:mimelux_dev@localhost:5432/mimelux?schema=public

# Troque por valores longos e aleatórios fora do demo
AUTH_SECRET=change-me
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Server-side base used by the Next session routes. Includes the /v1 prefix.
API_URL=http://127.0.0.1:3334/v1
WEB_ORIGIN=http://127.0.0.1:3333
# httpOnly cookies are Secure in production. Set true only behind HTTPS.
COOKIE_SECURE=false
# Auth limit per real client IP. Production defaults to 10 when unset and NODE_ENV=production.
AUTH_RATE_LIMIT=120
# Failed login attempts per email inside AUTH_RATE_TTL_MS. Defaults to 5.
AUTH_EMAIL_FAIL_LIMIT=5
AUTH_RATE_TTL_MS=60000
# Shared by the Next server and the API. The API trusts x-patrocino-client-ip only with this secret.
INTERNAL_PROXY_SECRET=
# Express trust proxy (true, a hop count, or loopback). Leave false to ignore raw X-Forwarded-For.
TRUST_PROXY=false

# Verification email. When RESEND_API_KEY is empty, the API logs the link and login stays open.
RESEND_API_KEY=
EMAIL_FROM=Patrocino <no-reply@patrocino.com>

# O web continua em mocks se a API estiver offline
NEXT_PUBLIC_API_URL=http://localhost:3334/v1
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Created on seed and API startup only when both are set. Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe stays off until real keys are present. Live keys also require STRIPE_ALLOW_LIVE=true.
# Checkout return URLs use WEB_ORIGIN. Point the Stripe webhook at POST /v1/payments/webhooks/stripe
# and subscribe to: checkout.session.completed, invoice.paid, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted, charge.refunded,
# payment_intent.succeeded, payment_intent.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ExPay Brasil. Never commit a real key. Test and production share this header;
# the ExPay dashboard webhook environment selects the account.
# PAYMENTS_PROVIDER is not the switch for checkout.
PAYMENTS_PROVIDER=demo
EXPAY_API_KEY=
EXPAY_BASE_URL=https://api.expaybrasil.com/api/v1
EXPAY_WEBHOOK_SECRET=
# TODO-to-confirm: the signing header name is a guess. Replace it when ExPay confirms the header.
EXPAY_WEBHOOK_SIGNATURE_HEADER=X-Expay-Signature

# weekly | biweekly | monthly. The weekly default is not a confirmed product decision.
NEXT_PUBLIC_PAYOUT_SCHEDULE=weekly

# Creator uploads. On the VPS this directory is bind-mounted into the API container.
MEDIA_ROOT=/opt/patrocino/media
MEDIA_PHOTO_MAX_BYTES=31457280
MEDIA_VIDEO_MAX_BYTES=2000000000
MEDIA_CHUNK_BYTES=5242880
