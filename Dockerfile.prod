FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates ffmpeg && rm -rf /var/lib/apt/lists/* && corepack enable
WORKDIR /app
COPY . .
ENV GEOIP_DB_PATH=/app/data/geoip/country.mmdb
RUN node scripts/download-geoip.mjs || echo "geoip download failed; startup will retry"
ARG NEXT_PUBLIC_API_URL=/v1
ARG NEXT_PUBLIC_CONTENT_MODE=hybrid
ARG NEXT_PUBLIC_DEMO_MODE=true
ARG NEXT_PUBLIC_PAYOUT_SCHEDULE=weekly
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ARG NEXT_PUBLIC_GA_ID=G-DKVQZBEHY6
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_CONTENT_MODE=$NEXT_PUBLIC_CONTENT_MODE NEXT_PUBLIC_DEMO_MODE=$NEXT_PUBLIC_DEMO_MODE NEXT_PUBLIC_PAYOUT_SCHEDULE=$NEXT_PUBLIC_PAYOUT_SCHEDULE NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY NEXT_PUBLIC_GA_ID=$NEXT_PUBLIC_GA_ID NEXT_TELEMETRY_DISABLED=1 CI=true
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @mimelux/api build && NODE_ENV=production pnpm --filter @mimelux/web build
ENV NODE_ENV=production
