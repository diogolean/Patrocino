generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FAN
  CREATOR
  AFFILIATE
  MODERATOR
  ADMIN
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum PayoutMethod {
  PIX
  STRIPE
  CRYPTO
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
}

enum CreatorStatus {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum OwnershipType {
  HOUSE
  INDEPENDENT
}

enum ContentVisibility {
  FREE
  SUBSCRIBERS
  PPV
  SUBSCRIBER_PPV
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum PurchaseKind {
  SUBSCRIPTION
  POST
  MESSAGE
  PACK
  SPECIAL_REQUEST
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum SpecialRequestStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  PAID
  DELIVERED
  DECLINED
  REFUNDED
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  role             UserRole         @default(FAN)
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  refreshTokenHash           String?
  stripeCustomerId String?          @unique
  googleSub        String?          @unique
  suspendedAt      DateTime?
  deletedAt        DateTime?
  mustResetPassword Boolean         @default(false)
  passwordSetTokenHash String?      @unique
  passwordSetExpiresAt DateTime?
  acceptedTermsAt  DateTime?
  termsVersion     String?
  acceptedTermsIp  String?
  locale           String?
  referredClickId  String?
  isDemo           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  creator          Creator?
  profile          Profile?
  subscriptions    Subscription[]   @relation("FanSubscriptions")
  purchases        Purchase[]       @relation("BuyerPurchases")
  messages         Message[]        @relation("SentMessages")
  ledgerEntries    LedgerEntry[]    @relation("UserLedger")
  reportsCreated   Report[]         @relation("Reporters")
  reportsReceived  Report[]         @relation("ReportedUsers")
  auditLogs        AuditLog[]       @relation("AuditActors")
  affiliate        Affiliate?
  attributions     Attribution[]    @relation("AttributedFans")
  specialRequests  SpecialRequest[] @relation("FanSpecialRequests")
  consents         ConsentRecord[]
  privacyRequests  PrivacyRequest[]
  fanConversations Conversation[]   @relation("FanConversations")
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Creator {
  id                   String           @id @default(cuid())
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               CreatorStatus    @default(DRAFT)
  category             String
  aiGenerated          Boolean          @default(false)
  fictitious           Boolean          @default(false)
  acceptsAffiliates    Boolean          @default(true)
  commissionBps        Int              @default(2000)
  commissionOnPpv      Boolean          @default(true)
  commissionOnPacks    Boolean          @default(true)
  commissionOnRequests Boolean          @default(true)
  ownership            OwnershipType    @default(HOUSE)
  creatorShareBps      Int?
  affiliateCommissionBps Int?
  defaultVideoPriceCents Int            @default(100)
  defaultVideoPriceCentsUsd Int         @default(1900)
  guestVideoPriceCents    Int?
  guestVideoPriceCentsUsd Int?
  isDemo               Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  plans                Plan[]
  subscriptions        Subscription[]
  posts                Post[]
  purchases            Purchase[]
  ledgerEntries        LedgerEntry[]
  affiliateLinks       AffiliateLink[]
  affiliateAssignments AffiliateAssignment[]
  promotions           Promotion[]
  contentPacks         ContentPack[]
  specialRequests      SpecialRequest[]
  reviews              Review[]
  conversations        Conversation[]
  chatSequence         ChatSequence?

  @@map("creators")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  username  String   @unique
  bio       String?
  city      String?
  avatarUrl String?
  coverUrl  String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Plan {
  id              String         @id @default(cuid())
  creatorId       String
  creator         Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name            String
  description     String
  priceCents      Int
  priceCentsUsd   Int            @default(0)
  durationMonths  Int            @default(1)
  discountPercent Int            @default(0)
  active          Boolean        @default(true)
  stripeProductId String?
  stripePriceId   String?
  stripePriceIdUsd String?
  isDemo          Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
  promotions      Promotion[]

  @@index([creatorId])
  @@map("plans")
}

model Subscription {
  id        String             @id @default(cuid())
  fanId     String
  fan       User               @relation("FanSubscriptions", fields: [fanId], references: [id], onDelete: Cascade)
  creatorId String
  creator   Creator            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(PENDING)
  startsAt            DateTime?
  endsAt              DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  currency            String             @default("BRL")
  stripeSubscriptionId String?           @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  isDemo              Boolean            @default(false)
  purchases           Purchase[]
  chatSequenceJobs    ChatSequenceJob[]

  @@unique([fanId, creatorId])
  @@index([creatorId, status])
  @@map("subscriptions")
}

model Post {
  id          String            @id @default(cuid())
  creatorId   String
  creator     Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  caption     String
  visibility  ContentVisibility @default(FREE)
  priceCents  Int?
  priceCentsUsd Int?
  guestPriceCents Int?
  guestPriceCentsUsd Int?
  likeCount   Int               @default(0)
  sortOrder   Int               @default(0)
  isDemo      Boolean           @default(false)
  publishedAt DateTime?
  deletedAt   DateTime?
  contentHash String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  media       Media[]
  purchases   Purchase[]
  reports     Report[]
  packItems   ContentPackItem[]
  comments    PostComment[]
  offeredIn   Message[]         @relation("MessageOffers")
  sequenceSteps ChatSequenceStep[]

  @@unique([creatorId, contentHash])
  @@index([creatorId, publishedAt])
  @@map("posts")
}

model Media {
  id         String    @id @default(cuid())
  postId     String?
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  messageId  String?
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind       MediaKind
  storageKey String
  mimeType   String
  width      Int?
  height     Int?
  durationMs Int?
  posterKey  String?
  previewKey String?
  byteSize   Int?
  private    Boolean   @default(false)
  isDemo     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([postId])
  @@index([messageId])
  @@map("media")
}

model MediaUpload {
  id          String   @id @default(cuid())
  creatorId   String
  actorId     String
  filename    String
  mimeType    String
  byteSize    Int
  chunkSize   Int
  totalChunks Int
  tempDir     String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([creatorId, status])
  @@map("media_uploads")
}

model Purchase {
  id             String          @id @default(cuid())
  buyerId        String
  buyer          User            @relation("BuyerPurchases", fields: [buyerId], references: [id])
  creatorId      String
  creator        Creator         @relation(fields: [creatorId], references: [id])
  postId         String?
  post           Post?           @relation(fields: [postId], references: [id])
  messageId      String?
  message        Message?        @relation(fields: [messageId], references: [id])
  contentPackId  String?
  contentPack    ContentPack?    @relation(fields: [contentPackId], references: [id])
  kind           PurchaseKind
  status         PurchaseStatus  @default(PENDING)
  amountCents    Int
  currency       String          @default("BRL")
  idempotencyKey String          @unique
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  providerRef    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isDemo         Boolean         @default(false)
  ledgerEntries  LedgerEntry[]
  paymentEvents  PaymentEvent[]
  conversion     Conversion?
  specialRequest SpecialRequest?

  @@index([buyerId, status])
  @@index([creatorId, status])
  @@index([subscriptionId])
  @@index([providerRef])
  @@map("purchases")
}

model PlatformSettings {
  id                     String   @id @default("default")
  creatorShareBps        Int      @default(8000)
  affiliateCommissionBps Int      @default(2000)
  defaultPackPriceCentsBrl Int   @default(14900)
  defaultPackPriceCentsUsd Int   @default(4900)
  updatedAt              DateTime @updatedAt

  @@map("platform_settings")
}

model Conversation {
  id             String    @id @default(cuid())
  participantIds Json
  fanId          String?
  creatorId      String?
  fan            User?     @relation("FanConversations", fields: [fanId], references: [id], onDelete: Cascade)
  creator        Creator?  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isDemo         Boolean   @default(false)
  messages       Message[]

  @@unique([fanId, creatorId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  body           String
  ppvPriceCents  Int?
  ppvPriceCentsUsd Int?
  offerPostId    String?
  offerPost      Post?        @relation("MessageOffers", fields: [offerPostId], references: [id], onDelete: SetNull)
  isDemo         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  media          Media[]
  purchases      Purchase[]
  reports        Report[]

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@index([offerPostId])
  @@map("messages")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

model ChatSequence {
  id        String             @id @default(cuid())
  creatorId String             @unique
  creator   Creator            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  steps     ChatSequenceStep[]

  @@map("chat_sequences")
}

model ChatSequenceStep {
  id            String       @id @default(cuid())
  sequenceId    String
  sequence      ChatSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  position      Int
  delayMinutes  Int
  bodyTemplate  String
  offerMode     String       @default("none")
  postId        String?
  post          Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)
  recurring     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([sequenceId, position])
  @@index([postId])
  @@map("chat_sequence_steps")
}

model ChatSequenceJob {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  position       Int
  runAt          DateTime
  status         String       @default("pending")
  messageId      String?
  cycle          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([subscriptionId, position])
  @@index([status, runAt])
  @@map("chat_sequence_jobs")
}

model LedgerEntry {
  id          String          @id @default(cuid())
  userId      String?
  user        User?           @relation("UserLedger", fields: [userId], references: [id])
  creatorId   String?
  creator     Creator?        @relation(fields: [creatorId], references: [id])
  purchaseId  String?
  purchase    Purchase?       @relation(fields: [purchaseId], references: [id])
  direction   LedgerDirection
  account     String
  amountCents Int
  currency    String          @default("BRL")
  reference   String
  createdAt   DateTime        @default(now())

  @@index([purchaseId])
  @@index([creatorId, createdAt])
  @@map("ledger_entries")
}

model PaymentRecord {
  id               String    @id @default(cuid())
  provider         String    @default("expay")
  providerChargeId String    @unique
  buyerId          String
  creatorId        String
  purpose          String
  subjectId        String
  description      String
  amountCents      Int
  currency         String    @default("BRL")
  status           String
  billingMode      String
  mandateId        String?
  copiaECola       String?
  qrCode           String?
  idempotencyKey   String    @unique
  accessActive     Boolean   @default(false)
  paidAt           DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([buyerId, purpose, subjectId])
  @@index([status])
  @@map("payment_records")
}

model PaymentWebhookReceipt {
  id               String    @id @default(cuid())
  provider         String    @default("expay")
  providerEventId  String
  providerChargeId String
  eventType        String
  environment      String
  payload          Json
  processedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@unique([provider, providerEventId, environment])
  @@index([providerChargeId])
  @@map("payment_webhook_receipts")
}

model PixMandateRecord {
  id                String   @id @default(cuid())
  providerMandateId String   @unique
  buyerId           String
  creatorId         String
  subjectId         String
  amountCents       Int
  status            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([buyerId, creatorId])
  @@map("pix_mandate_records")
}

model PaymentEvent {
  id          String    @id @default(cuid())
  provider    String
  providerId  String
  purchaseId  String?
  purchase    Purchase? @relation(fields: [purchaseId], references: [id])
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, providerId])
  @@index([purchaseId])
  @@map("payment_events")
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("Reporters", fields: [reporterId], references: [id])
  targetUserId String?
  targetUser   User?        @relation("ReportedUsers", fields: [targetUserId], references: [id])
  postId       String?
  post         Post?        @relation(fields: [postId], references: [id])
  messageId    String?
  message      Message?     @relation(fields: [messageId], references: [id])
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
  @@map("reports")
}

model ConsentRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  necessary  Boolean  @default(true)
  analytics  Boolean  @default(false)
  marketing  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("consent_records")
}

model PrivacyRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@map("privacy_requests")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActors", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  ipHash     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Promotion {
  id              String   @id @default(cuid())
  creatorId       String
  creator         Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  planId          String?
  plan            Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  name            String
  discountPercent Int
  startsAt        DateTime
  endsAt          DateTime
  subscriberCap   Int?
  redeemedCount   Int      @default(0)
  active          Boolean  @default(true)
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([creatorId, startsAt, endsAt])
  @@map("promotions")
}

model ContentPack {
  id          String            @id @default(cuid())
  creatorId   String
  creator     Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name        String
  description String
  priceCents  Int
  priceCentsUsd Int             @default(0)
  active      Boolean           @default(true)
  isDemo      Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       ContentPackItem[]
  purchases   Purchase[]
  affiliateLinks AffiliateLink[]

  @@index([creatorId, active])
  @@map("content_packs")
}

model ContentPackItem {
  id     String      @id @default(cuid())
  packId String
  pack   ContentPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  postId String
  post   Post        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([packId, postId])
  @@map("content_pack_items")
}

model SpecialRequest {
  id                   String                  @id @default(cuid())
  fanId                String
  fan                  User                    @relation("FanSpecialRequests", fields: [fanId], references: [id])
  creatorId            String
  creator              Creator                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  purchaseId           String?                 @unique
  purchase             Purchase?               @relation(fields: [purchaseId], references: [id])
  description          String
  requestedBudgetCents Int?
  quotedPriceCents     Int?
  status               SpecialRequestStatus    @default(REQUESTED)
  deliveryUrl          String?
  isDemo               Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  messages             SpecialRequestMessage[]

  @@index([creatorId, status])
  @@index([fanId, createdAt])
  @@map("special_requests")
}

model SpecialRequestMessage {
  id         String         @id @default(cuid())
  requestId  String
  request    SpecialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderRole UserRole
  body       String
  createdAt  DateTime       @default(now())

  @@index([requestId, createdAt])
  @@map("special_request_messages")
}

model Affiliate {
  id            String          @id @default(cuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String          @unique
  displayName   String
  commissionBps Int             @default(2000)
  emailPlaceholder Boolean         @default(false)
  status        String          @default("ACTIVE")
  payoutMethod  PayoutMethod    @default(PIX)
  payoutDetails Json?
  isDemo        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  links         AffiliateLink[]
  assignments   AffiliateAssignment[]
  commissions   Commission[]
  payouts       Payout[]

  @@map("affiliates")
}

model AffiliateAssignment {
  id            String    @id @default(cuid())
  affiliateId   String
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  commissionBps Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([affiliateId, creatorId])
  @@index([creatorId])
  @@map("affiliate_assignments")
}

model AffiliateLink {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  packId      String?
  pack        ContentPack? @relation(fields: [packId], references: [id], onDelete: SetNull)
  label       String?
  slug        String
  code        String    @unique
  active      Boolean   @default(true)
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  clicks      Click[]

  @@index([affiliateId, creatorId])
  @@index([slug])
  @@map("affiliate_links")
}

model Click {
  id          String        @id @default(cuid())
  linkId      String
  link        AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  subId       String?
  locale      String?
  ipHash      String?
  userAgent   String?
  suspicious  Boolean       @default(false)
  isDemo      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  attribution Attribution?

  @@index([linkId, createdAt])
  @@map("clicks")
}

model Attribution {
  id            String       @id @default(cuid())
  clickId       String       @unique
  click         Click        @relation(fields: [clickId], references: [id], onDelete: Cascade)
  fanId         String?
  fan           User?        @relation("AttributedFans", fields: [fanId], references: [id])
  expiresAt     DateTime
  blockedReason String?
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  conversions   Conversion[]

  @@index([fanId])
  @@map("attributions")
}

model Conversion {
  id            String       @id @default(cuid())
  attributionId String
  attribution   Attribution  @relation(fields: [attributionId], references: [id], onDelete: Cascade)
  purchaseId    String?      @unique
  purchase      Purchase?    @relation(fields: [purchaseId], references: [id])
  kind          String
  amountCents   Int
  currency      String       @default("BRL")
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  commissions   Commission[]

  @@index([attributionId])
  @@map("conversions")
}

model Commission {
  id           String           @id @default(cuid())
  affiliateId  String
  affiliate    Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  conversionId String
  conversion   Conversion       @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  payoutId     String?
  payout       Payout?          @relation(fields: [payoutId], references: [id])
  rateBps      Int
  amountCents  Int
  currency     String           @default("BRL")
  status       CommissionStatus @default(PENDING)
  holdUntil    DateTime
  renewalUntil DateTime
  isDemo       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([affiliateId, status])
  @@map("commissions")
}

model Payout {
  id          String       @id @default(cuid())
  affiliateId String
  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  method      PayoutMethod
  amountCents Int
  currency    String       @default("BRL")
  status      PayoutStatus @default(REQUESTED)
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  commissions Commission[]

  @@index([affiliateId, status])
  @@map("payouts")
}

model Review {
  id         String   @id @default(cuid())
  creatorId  String
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  body       String
  subscriber Boolean  @default(true)
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([creatorId, createdAt])
  @@map("reviews")
}

model PostComment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName String
  body       String
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
  @@map("post_comments")
}
