}
(app) {
	encode zstd gzip
	handle /v1* {
		reverse_proxy api:3334 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	@private path /media/uploads/*/private /media/uploads/*/private/* /media/uploads/*/tmp /media/uploads/*/tmp/*
	handle @private {
		respond 404
	}
	@disk path /media/models/* /media/uploads/*
	handle @disk {
		uri strip_prefix /media
		root * /srv/media
		header >Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		reverse_proxy web:3333 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}
patrocino.com, www.patrocino.com {
	import app
}
api.patrocino.com {
	reverse_proxy api:3334 {
		header_up X-Forwarded-For {remote_host}
	}
}
http://2.25.182.133, http://localhost {
	import app
}
