}
(app) {
	encode zstd gzip
	handle /v1* {
		reverse_proxy api:3334 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	# A path pattern with more than one * does not cross "/". The old matcher
	# therefore missed private/posters and private/previews, and /media/uploads/*
	# (a prefix match) served them. Block every private and tmp subpath.
	@private path_regexp (?i)^/media/uploads/[^/]+/(private|tmp)(/|$)
	handle @private {
		route {
			header Cache-Control "private, no-store"
			header CDN-Cache-Control "no-store"
			respond 404
		}
	}
	@disk path /media/models/* /media/uploads/*
	handle @disk {
		uri strip_prefix /media
		root * /srv/media
		header >Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		reverse_proxy web:3333 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}
patrocino.com, www.patrocino.com {
	import app
}
api.patrocino.com {
	reverse_proxy api:3334 {
		header_up X-Forwarded-For {remote_host}
	}
}
http://2.25.182.133, http://localhost {
	import app
}
